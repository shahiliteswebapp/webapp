# Copy to .env.local and fill in. The app runs fully in local mock mode with
# nothing set here.

# --- Google sign-in (Auth.js) ---
# AUTH_SECRET is required for real Google sign-in. Generate one: npx auth secret
# AUTH_SECRET=
# From Google Cloud Console -> Credentials -> OAuth 2.0 Client ID.
# Authorized redirect URI (dev):  http://localhost:3000/api/auth/callback/google
# Google sign-in activates automatically once BOTH of these are present.
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# Comma-separated emails that get the superadmin role. A superadmin can always
# sign in; everyone else needs an active row in the access list (managed from
# /admin). MANAGER_EMAILS also works, kept as an alias.
# SUPERADMIN_EMAILS=

# --- Email (quotation PDF + approve/reject notifications) ---
# When GMAIL_APP_PASSWORD is unset, sending is stubbed (PDF handed to the
# browser as a download; also written to ./output outside Vercel).
# GMAIL_APP_PASSWORD=          # 16-char Gmail app password (needs 2FA on)
# GMAIL_SENDER=shahiliteswebapp@gmail.com
# QUOTE_RECIPIENT=              # overrides the reviewer email "send for review" uses

# --- Supabase (recommended once you have more than one machine involved) ---
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SECRET_KEY=          # Project Settings -> API -> Secret keys
# DATABASE_URL=
